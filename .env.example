# Network: devnet | mainnet-beta
SOLANA_NETWORK=devnet
# Server RPC. May carry an API key; used only by route handlers, never sent to the browser.
RPC_URL=https://api.devnet.solana.com
# Browser RPC. Returned by /api/config and used by the wallet adapter, so keep it keyless and CORS-open.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
APP_NAME=Project: Takeover
# Platform fee in basis points (200 = 2%)
FEE_BPS=200
# Escrow wallet secret key (base58 or JSON byte array). If unset, one is generated into data/escrow-keypair.json
# ESCROW_SECRET_KEY=
# Comma-separated wallet pubkeys allowed to resolve disputes
ADMIN_PUBKEYS=
# DB_PATH=./data/takeover.db

# Wallet that receives the platform fee. The server never signs for it.
TREASURY_PUBKEY=
