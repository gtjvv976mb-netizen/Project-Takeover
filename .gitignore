# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (the example is the only one that belongs in git)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime data: sqlite db, escrow keypair, test keypairs, generated screenshots. NEVER commit.
/data/
/shots/

# rust / anchor build output
/target
/.anchor
test-ledger

# Metaplex binary used only by the local test suite
tests/fixtures/*.so
